<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GA4 운영 리포트 {{ day }}</title>
{% include "_style.html" %}
</head>
<body>
<header class="topbar">
  <h1>GA4 Merch Shop · 운영 KPI 리포트</h1>
  <span class="sub">기준일 {{ day }} ({{ weekday }}) · 갱신 {{ generated }} ·
    {% if verified %}<span class="ok">숫자 검증 통과 ✓</span>{% else %}<a class="warn" href="#quality">숫자 확인 필요 (데이터 품질 탭)</a>{% endif %}
    · 공개 샘플 데이터를 하루씩 리플레이</span>
</header>

<div class="slicers">
  <div class="slicer">
    <label for="day">날짜</label>
    <select id="day">
      {% for d in days %}<option value="{{ d }}" {% if d == day %}selected{% endif %}>{{ d }}</option>{% endfor %}
    </select>
  </div>
  <a class="pill screen-only" href="../reports.html" style="color:inherit;text-decoration:none">일별 리포트 목록</a>
  <a class="pill screen-only" href="../pdf/{{ day }}.pdf" style="color:inherit;text-decoration:none">PDF 저장본</a>
</div>

<main>
<!-- Page 1: overview -->
<section class="page" id="overview">
  <h2 class="print-only">1. 개요</h2>
  <div class="row2 row-top">
    <div class="visual today">
      <h2>오늘 볼 것</h2>
      {% if today %}
        <ul class="today-list">{% for t in today %}
          <li><span class="{{ 'up' if t.up else 'down' }}">{{ '▲' if t.up else '▼' }}</span>
            <b>{{ t.name }}</b> {{ t.basis }} <span class="num">{{ t.change }}</span> <span class="flag">주목</span></li>
        {% endfor %}</ul>
      {% else %}
        <p class="calm">오늘은 모든 헤드라인 지표가 평소 범위예요.</p>
      {% endif %}
    </div>
    <div class="visual">
      <h2>어디서 변했나 <span class="funnel-meta">최근 7일 vs 직전 7일</span></h2>
      {% if where %}
        <p class="terms num">{% for t in terms %}{{ t.label }} {{ t.change }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
        <ul class="where-list">{% for l in where %}<li{% if l.muted %} class="muted"{% endif %}>{{ l.text }}</li>{% endfor %}</ul>
        <p class="note">무엇이 어디서 움직였는지까지만 보여줘요. 이유는 담당자가 확인해요.</p>
      {% else %}
        <p class="note">최근 14일 데이터가 모이면 표시돼요.</p>
      {% endif %}
    </div>
  </div>

  <div class="tiles">
    {% for t in tiles %}
    <div class="visual tile" title="{{ t.label }}: {{ t.definition }}">
      <div class="label"><span>{{ t.label }} <span class="info" aria-hidden="true">ⓘ</span></span>{% if t.notable %}<span class="flag">주목</span>{% endif %}</div>
      <div class="value num">{{ t.value }}</div>
      <div class="delta {{ 'up' if t.delta_sign > 0 else 'down' if t.delta_sign < 0 else 'flat' }}">
        {{ '▲' if t.delta_sign > 0 else '▼' if t.delta_sign < 0 else '' }} {{ t.delta }}</div>
      <div class="basis">{{ t.basis }}</div>
      <div class="more">전일 {{ t.dod }} · 같은 요일 {{ t.wow }} · 최근 7일 {{ t.r7 }}</div>
      {{ t.spark | safe }}
    </div>
    {% endfor %}
  </div>

  <div class="row3">
    <div class="visual"><h2>매출 · 최근 28일</h2>{{ charts.revenue | safe }}</div>
    <div class="visual"><h2>세션 · 최근 28일</h2>{{ charts.sessions | safe }}</div>
  </div>
  <div class="ai-row">
    <div class="visual ai">
      <h2>AI 일일 코멘트</h2>
      {% if ai.ok %}
        <p class="ai-headline">{{ ai.headline }}</p>
        {% if ai.highlights %}<h3>주목할 변화</h3><ul>{% for h in ai.highlights %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}
        {% if ai.watch_items %}<h3>확인할 것</h3><ul>{% for w in ai.watch_items %}<li>{{ w }}</li>{% endfor %}</ul>{% endif %}
        <p class="meta">{{ ai.model }}가 작성했어요. 문장 속 숫자는 모두 SQL 집계 결과에서 채워 넣었어요.</p>
      {% else %}
        <p class="note">{{ ai.reason }} 아래 숫자는 SQL 집계 결과 그대로라 정상이에요.</p>
        {% if ai.errors %}<ul class="note">{% for e in ai.errors %}<li>{{ e }}</li>{% endfor %}</ul>{% endif %}
      {% endif %}
    </div>
  </div>
</section>

<!-- Page 2: funnel + metric detail -->
<section class="page" id="funnel">
  <h2 class="print-only">2. 퍼널 · 지표 상세</h2>
  <div class="visual">
    <h2>구매 퍼널 (최근 7일 세션)</h2>
    <p class="note" style="margin-bottom:8px">상품 조회 → 체크아웃 → 구매. 장바구니는 건너뛰는 구매(바로 구매)가 많아 퍼널 단계에서 뺐어요.</p>
    {% for s in funnel %}
    <div class="funnel-row">
      <span>{{ s.label }}</span>
      <div><div class="funnel-bar" style="width: {{ '%.1f' % s.pct }}%" title="{{ s.label }} {{ s.value }}"></div>
        <span class="funnel-meta num">{{ s.value }} 세션 · 전체의 {{ '%.1f' % s.pct }}%{% if s.step %} · {{ s.step }}{% endif %}</span></div>
    </div>
    {% endfor %}
    <p class="note num" style="margin-top:8px">참고: 상품 조회 세션 중 장바구니에 담은 비율 {{ cart_rate }}</p>
  </div>
  <div class="visual">
    <h2>세그먼트별 세션 전환율 (최근 7일 vs 직전 7일)</h2>
    {% if segments %}
    <div class="table-wrap"><table>
      <thead><tr><th>구분</th><th>세그먼트</th><th class="r">세션</th><th class="r">비중 (변화)</th><th class="r">전환율 (변화)</th><th class="r">전체 전환율 변화 중 몫</th></tr></thead>
      <tbody>{% for e in segments %}{% for g in e.segments %}
        <tr><td>{{ e.dim if loop.first else '' }}</td><td>{{ g.label }}</td><td class="r">{{ '{:,.0f}'.format(g.sessions) }}</td>
        <td class="r">{{ '%.1f' % (g.share * 100) }}% ({{ g.share_change_pp }})</td>
        <td class="r">{% if g.small %}표본 적음{% else %}{{ '%.2f' % (g.cvr * 100) }}% ({{ g.cvr_change_pp }}){% endif %}</td>
        <td class="r">{{ g.rate_effect_pp }}</td></tr>
      {% endfor %}
        <tr class="sub-total"><td></td><td colspan="5">구성 변화 {{ e.mix_pp }} · {{ e.dim }} 안 전환율 변화 {{ e.rate_pp }} · 교차 {{ e.inter_pp }}</td></tr>
      {% endfor %}</tbody>
    </table></div>
    <p class="note" style="margin-top:8px">전체 전환율 변화 = 구성 변화(세그먼트 비중이 바뀐 몫) + 세그먼트 안 전환율 변화 + 교차. 세 값의 합은 전체 변화와 같아요. 7일 세션 100개 미만은 전환율을 표시하지 않아요.</p>
    {% else %}<p class="note">최근 14일 데이터가 모이면 표시돼요.</p>{% endif %}
  </div>
  <div class="visual">
    <h2>지표 상세 (지표 정의집 Tier 1·2)</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>지표</th><th class="r">당일</th><th class="r">전일 대비</th><th class="r">같은 요일 대비</th><th class="r">7일 vs 직전 7일</th><th class="r">전월 누적 대비</th><th>판정</th></tr></thead>
      <tbody>{% for r in detail %}
        <tr><td>{{ r.name }}</td><td class="r">{{ r.day }}</td><td class="r">{{ r.dod }}</td><td class="r">{{ r.wow }}</td>
        <td class="r">{{ r.r7 }}</td><td class="r">{{ r.mom }}</td>
        <td>{% if r.flag == 'notable' %}<span class="flag">주목</span>{% elif r.flag == 'normal' %}정상{% else %}–{% endif %}</td></tr>
      {% endfor %}</tbody>
    </table></div>
    <p class="note" style="margin-top:8px">비율 지표는 %p 차이, 나머지는 증감률이에요. 활성 사용자의 7일·전월 비교는 고유 사용자가 아니라 일별 사용자 수의 합으로 계산해요. 판정은 지표 정의집의 비교 기준과 임계치를 따라요.</p>
  </div>
</section>

<!-- Page 3: data quality -->
<section class="page" id="quality">
  <h2 class="print-only">3. 데이터 품질</h2>
  <div class="visual">
    <h2>데이터 품질 체크와 집계 대사</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>상태</th><th>체크</th><th>기준</th><th>세부</th></tr></thead>
      <tbody>{% for r in dq %}
        <tr><td><span class="pill"><span class="dot {{ r.badge[0] }}">{{ r.badge[1] }}</span>{{ r.badge[2] }}</span></td>
        <td>{{ r.check_name }}<br><span class="funnel-meta">{{ r.check_id }}</span></td>
        <td class="funnel-meta">{{ r.threshold }}</td><td class="funnel-meta">{{ r.detail }}</td></tr>
      {% endfor %}</tbody>
    </table></div>
    <p class="note" style="margin-top:8px">DQ는 데이터 품질 체크, R은 같은 숫자를 다른 단위로 계산해 맞춰보는 대사 규칙이에요. 하나라도 실패하면 그날 리포트는 해석 보류로 표시돼요.</p>
  </div>
</section>
<footer>생성 {{ generated }} · 정의: docs/ops_bi/02_ops_metric_definitions.md</footer>
</main>

<nav class="tabs">
  <a href="#overview">개요</a><a href="#funnel">퍼널 · 지표 상세</a><a href="#quality">데이터 품질</a>
</nav>
<div class="tip" id="tip"></div>

<script>
// Page tabs (hash-based, like Power BI report pages)
function showPage() {
  const id = (location.hash || "#overview").slice(1);
  document.querySelectorAll(".page").forEach(p => p.classList.toggle("active", p.id === id));
  document.querySelectorAll("nav.tabs a").forEach(a => a.classList.toggle("active", a.hash === "#" + id));
}
addEventListener("hashchange", showPage); showPage();

// Date slicer: each day is its own static page
document.getElementById("day").addEventListener("change", e => { location.href = e.target.value + ".html" + location.hash; });

// Line chart crosshair + tooltip
const tip = document.getElementById("tip");
document.querySelectorAll("svg.chart").forEach(svg => {
  const d = JSON.parse(svg.dataset.points);
  const hair = svg.querySelector(".xhair"), dot = svg.querySelector(".xdot");
  svg.querySelector(".hit").addEventListener("pointermove", ev => {
    const pt = svg.createSVGPoint(); pt.x = ev.clientX; pt.y = ev.clientY;
    const x = pt.matrixTransform(svg.getScreenCTM().inverse()).x;
    let i = 0; d.x.forEach((v, k) => { if (Math.abs(v - x) < Math.abs(d.x[i] - x)) i = k; });
    hair.setAttribute("x1", d.x[i]); hair.setAttribute("x2", d.x[i]);
    if (d.y[i] !== null) { dot.setAttribute("cx", d.x[i]); dot.setAttribute("cy", d.y[i]); }
    tip.replaceChildren();
    const s = document.createElement("strong"); s.textContent = d.labels[i];
    tip.append(s, document.createTextNode(d.dates[i]));
    tip.style.display = "block"; tip.style.left = (ev.clientX + 12) + "px"; tip.style.top = (ev.clientY - 40) + "px";
  });
  svg.querySelector(".hit").addEventListener("pointerleave", () => {
    tip.style.display = "none"; hair.setAttribute("x1", -10); hair.setAttribute("x2", -10); dot.setAttribute("cx", -10);
  });
});
</script>
</body>
</html>
